# 이 파일을 .env.local 로 복사한 뒤 값을 채워 주세요.
# .env.local 은 .gitignore 에 포함되어 커밋되지 않아요.

# Claude (BASE_URL 생략 시 baze 게이트웨이 사용)
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
CLAUDE_MODEL=

# GPT
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Gemini
GEMINI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Supabase (생략 시 사용 기록·횟수 제한 없이 동작)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# IP당 하루 AI 다듬기 횟수 (기본 20)
DAILY_LIMIT=20
